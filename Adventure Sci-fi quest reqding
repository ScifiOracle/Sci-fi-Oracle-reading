            { id: 'MA-XIX', name: 'The Star Gate', type: 'The Sun (XIX)', description: 'Joy, Success, Vitality, Optimism, Warmth, Freedom.' },
            { id: 'MA-XX', name: 'The Judgment', type: 'Judgment (XX)', description: 'Call to Action, Reevaluation, Inner Vocation, Redemption, Awakening.' },
            { id: 'MA-XXI', name: 'The World', type: 'The World (XXI)', description: 'Completion, Success, Fulfillment, Travel, Harmony, Wholeness.' },

            // Court Cards (16)
            // Cups
            { id: 'CC-KC', name: 'The Diplomat', type: 'King of Cups', description: 'Emotional balance, diplomacy, and maturity. Offers sound advice and understanding.' },
            { id: 'CC-QC', name: 'The Seer', type: 'Queen of Cups', description: 'Compassion, intuition, emotional security, and a deep, loving nature.' },
            { id: 'CC-PC', name: 'The Empath', type: 'Page of Cups', description: 'Creative offers, emotional sensitivity, intuition, and a beginning of deep feeling.' },
            { id: 'CC-NC', name: 'The Navigator', type: 'Knight of Cups', description: 'Proposal, opportunity, pursuit of an ideal, romance, and charm.' },
            // Wands
            { id: 'CC-KW', name: 'The Commander', type: 'King of Wands', description: 'Vision, natural leader, strong will, entrepreneurial, and commanding presence.' },
            { id: 'CC-QW', name: 'The Visionary', type: 'Queen of Wands', description: 'Focused intention, vibrant energy, cheerfulness, and high self-esteem.' },
            { id: 'CC-PW', name: 'The Messenger', type: 'Page of Wands', description: 'Exciting news, new adventure, enthusiasm, and discovery.' },
            { id: 'CC-NW', name: 'The Adventurer', type: 'Knight of Wands', description: 'Energetic action, adventure, enthusiasm, rapid change and excitement.' },
            // Pentacles
            { id: 'CC-KP', name: 'The Financier', type: 'King of Pentacles', description: 'Financial success, material wealth, worldly mastery, built through hard work and discipline.' },
            { id: 'CC-QP', name: 'The Curator', type: 'Queen of Pentacles', description: 'Nurturing, practical, financially secure, comforting, and grounded.' },
            { id: 'CC-NP', name: 'The Supplier', type: 'Knight of Pentacles', description: 'Hard work, commitment, routine, patience, and slow but steady progress.' },
            { id: 'CC-PP', name: 'The Student', type: 'Page of Pentacles', description: 'New financial opportunity, ambition, learning, and study.' },
            // Swords (Rockets)
            { id: 'CC-KR', name: 'The Sovereign', type: 'King of Swords', description: 'Ambitious authority, clear judgment, intellectual power, law, order, and objective truth.' },
            { id: 'CC-QR', name: 'The Strategist', type: 'Queen of Swords', description: 'Sharp focus, independent, clear boundaries, and intellectual honesty.' },
            { id: 'CC-PR', name: 'The Analyst', type: 'Page of Swords', description: 'New ideas, curiosity, and the pursuit of truth and clarity, insightful new perspective.' },
            { id: 'CC-NR', name: 'The Explorer', type: 'Knight of Swords', description: 'Swift progress, ambition, breakthroughs in technology and exploration, taking bold action.' },
        ];

        document.getElementById('cardCount').textContent = ALL_CARDS.length;

        // --- Gemini API Setup ---
        const apiKey = ""; 
        const textToTextApiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-05-20:generateContent?key=${apiKey}`;
        const ttsApiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-tts:generateContent?key=${apiKey}`;
        const imageGenApiUrl = `https://generativelanguage.googleapis.com/v1beta/models/imagen-3.0-generate-002:predict?key=${apiKey}`;

        // --- Web Audio API Setup for robust playback ---
        let audioContext = null;
        let currentAudioSource = null;

        // --- NEW: Image Generation Function ---
        async function generateCardImage(card) {
            const prompt = `Epic sci-fi tarot card art for a card named "${card.name}". Cosmic, futuristic, intricate digital painting, vibrant colors, cinematic lighting. The card represents: ${card.description}. No text or words on the image.`;
            const payload = { 
                instances: [{ prompt: prompt }],
                parameters: { "sampleCount": 1 } 
            };

            try {
                const response = await fetch(imageGenApiUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                if (!response.ok) {
                    throw new Error(`Image API failed with status: ${response.status}`);
                }
                const result = await response.json();
                if (result.predictions && result.predictions[0]?.bytesBase64Encoded) {
                    return `data:image/png;base64,${result.predictions[0].bytesBase64Encoded}`;
                } else {
                    throw new Error("Invalid image data received.");
                }
            } catch (error) {
                console.error(`Failed to generate image for "${card.name}":`, error);
                return null; // Return null on failure
            }
        }

        // Utility function to handle API fetch with retries (for TEXT)
        async function fetchTextWithExponentialBackoff(payload, maxRetries = 5, delay = 1000) {
            // ... (existing code, no changes)
            for (let i = 0; i < maxRetries; i++) {
                try {
                    const response = await fetch(textToTextApiUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    if (response.ok) return await response.json();
                    if (response.status === 429 || response.status >= 500) {
                        await new Promise(resolve => setTimeout(resolve, delay));
                        delay *= 2;
                    } else {
                        const errorBody = await response.json();
                        throw new Error(`API Error: ${response.status} - ${JSON.stringify(errorBody)}`);
                    }
                } catch (error) {
                    if (i === maxRetries - 1) throw error;
                    await new Promise(resolve => setTimeout(resolve, delay));
                    delay *= 2;
                }
            }
        }
        
        // --- TTS Helper Functions ---
        function base64ToArrayBuffer(base64) {
            const binaryString = atob(base64);
            const len = binaryString.length;
            const bytes = new Uint8Array(len);
            for (let i = 0; i < len; i++) {
                bytes[i] = binaryString.charCodeAt(i);
            }
            return bytes.buffer;
        }

        function pcmToWav(pcm16, sampleRate) {
            const numChannels = 1, bytesPerSample = 2, buffer = new ArrayBuffer(44 + pcm16.length * bytesPerSample);
            const view = new DataView(buffer);
            const writeString = (view, offset, string) => { for (let i = 0; i < string.length; i++) view.setUint8(offset + i, string.charCodeAt(i)); };
            writeString(view, 0, 'RIFF');
            view.setUint32(4, 36 + pcm16.length * bytesPerSample, true);
            writeString(view, 8, 'WAVE');
            writeString(view, 12, 'fmt ');
            view.setUint32(16, 16, true);
            view.setUint16(20, 1, true);
            view.setUint16(22, numChannels, true);
            view.setUint32(24, sampleRate, true);
            view.setUint32(28, sampleRate * numChannels * bytesPerSample, true);
            view.setUint16(32, numChannels * bytesPerSample, true);
            view.setUint16(34, 16, true);
            writeString(view, 36, 'data');
            view.setUint32(40, pcm16.length * bytesPerSample, true);
            let offset = 44;
            for (let i = 0; i < pcm16.length; i++, offset += bytesPerSample) view.setInt16(offset, pcm16[i], true);
            return new Blob([view], { type: 'audio/wav' });
        }
        
        async function speakSummary() {
            const speakBtn = document.getElementById('speakButton');
            const summaryTextElement = document.getElementById('summaryText');
            const textToSpeak = summaryTextElement.textContent;

            // 1. Initialize Audio Context on user gesture (the click that calls this function)
            if (!audioContext) {
                try {
                    audioContext = new (window.AudioContext || window.webkitAudioContext)();
                } catch (e) {
                    console.error("Web Audio API is not supported.", e);
                    speakBtn.innerHTML = 'Audio Error';
                    return; // Can't proceed
                }
            }
            // Resume context if it's suspended (important for some browsers)
            if (audioContext.state === 'suspended') {
                audioContext.resume();
            }
            
            // Stop any currently playing audio from previous clicks
            if (currentAudioSource) {
                currentAudioSource.stop();
                currentAudioSource = null;
            }

            if (!textToSpeak || textToSpeak.includes('Generating') || textToSpeak.includes('Error:')) return;

            speakBtn.disabled = true;
            const originalContent = speakBtn.innerHTML;
            speakBtn.innerHTML = '<div class="loading-spinner-small"></div> Speaking...';
            
            const prompt = `Say in a firm, confident, and slightly mysterious voice: "${textToSpeak}"`;
            const payload = { contents: [{ parts: [{ text: prompt }] }], generationConfig: { responseModalities: ["AUDIO"], speechConfig: { voiceConfig: { prebuiltVoiceConfig: { voiceName: "Kore" } } } } };
            
            try {
                const response = await fetch(ttsApiUrl, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
                if (!response.ok) throw new Error(`TTS API failed: ${response.statusText}`);
                
                const result = await response.json();
                const part = result?.candidates?.[0]?.content?.parts?.[0];
                const audioData = part?.inlineData?.data;
                const mimeType = part?.inlineData?.mimeType;

                if (audioData && mimeType && mimeType.startsWith("audio/L16")) {
                    const sampleRate = parseInt(mimeType.match(/rate=(\d+)/)?.[1] || "24000", 10);
                    const pcm16 = new Int16Array(base64ToArrayBuffer(audioData));
                    const wavBlob = pcmToWav(pcm16, sampleRate);
                    const arrayBuffer = await wavBlob.arrayBuffer();

                    // 2. Decode and play using the unlocked AudioContext
                    audioContext.decodeAudioData(arrayBuffer, (buffer) => {
                        currentAudioSource = audioContext.createBufferSource();
                        currentAudioSource.buffer = buffer;
                        currentAudioSource.connect(audioContext.destination);
                        currentAudioSource.start(0);
                        
                        currentAudioSource.onended = () => {
                            speakBtn.disabled = false;
                            speakBtn.innerHTML = originalContent;
                            currentAudioSource = null;
                        };
                    }, (decodeError) => {
                        console.error("Error decoding audio data:", decodeError);
                        throw new Error("Failed to decode audio from the Oracle.");
                    });

                } else { 
                    throw new Error("Invalid audio data from the Oracle."); 
                }
            } catch (error) {
                console.error("TTS Error:", error);
                speakBtn.innerHTML = 'Error';
                setTimeout(() => {
                    speakBtn.innerHTML = originalContent;
                    speakBtn.disabled = false;
                }, 3000);
            }
        }


        // Utility function to shuffle an array (Fisher-Yates)
        function shuffleArray(array) {
            for (let i = array.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [array[i], array[j]] = [array[j], array[i]];
            }
            return array;
        }

        // Main function to draw and display the cards
        async function drawCards() {
            const cardsDisplay = document.getElementById('cardsDisplay');
            const summaryDisplay = document.getElementById('summaryDisplay');
            const summaryText = document.getElementById('summaryText');
            const shuffleBtn = document.getElementById('shuffleButton');
            const speakBtn = document.getElementById('speakButton');

            // 1. Setup UI for Drawing
            shuffleBtn.disabled = true;
            speakBtn.disabled = true;
            summaryDisplay.classList.add('hidden');
            summaryText.innerHTML = '';
            shuffleBtn.innerHTML = '<div class="loading-spinner"></div> Drawing...';
            
            // 2. Shuffle and select 3 cards
            const drawnCards = shuffleArray([...ALL_CARDS]).slice(0, 3);
            const cardPositions = ["The Situation", "The Challenge/Action", "The Outcome/Resolution"];
            
            // 3. Render Card Skeletons with Loaders
            cardsDisplay.innerHTML = '';
            let promptContent = "Synthesize the message of these three cards (Cosmic Sci-Fi Oracle):\n";
            drawnCards.forEach((card, index) => {
                const position = cardPositions[index];
                cardsDisplay.innerHTML += `
                    <div class="card-container p-2">
                        <div class="card bg-gray-800 rounded-xl overflow-hidden flex flex-col">
                            <div id="card-image-area-${index}" class="h-1/2 overflow-hidden bg-gray-700 relative flex items-center justify-center">
                                ✨<div class="image-loader"></div>
                            </div>
                            <div class="p-4 flex flex-col justify-between flex-grow">
                                <div>
                                    <h2 class="text-xl font-bold text-purple-300 mb-2">${card.name}</h2>
                                    <p class="text-sm text-gray-300 mb-3">${card.description}</p>
                                </div>
                                <div class="text-right text-xs font-semibold text-indigo-400 uppercase tracking-wider">${position}</div>
                            </div>
                        </div>
                    </div>`;
                promptContent += `Card ${index + 1} (${position}): ${card.name}. Meaning: ${card.description}\n`;
            });
            
            // 4. Generate Summary and Images in Parallel
            const summaryPromise = generateSummary(promptContent);
            const imagePromises = drawnCards.map(card => generateCardImage(card));

            // 5. Handle Summary Generation
            summaryText.innerHTML = '<div class="loading-spinner-small inline-block align-middle"></div> Generating cosmic summary...';
            summaryDisplay.classList.remove('hidden');
            try {
                const combinedSummary = await summaryPromise;
                summaryText.textContent = combinedSummary;
                speakBtn.disabled = false;
            } catch (error) {
                console.error("Summary generation failed:", error);
                summaryText.textContent = "Error: Failed to connect to the Cosmic Oracle for a summary.";
                speakBtn.disabled = true;
            }

            // 6. Handle Image Generation
            const imageResults = await Promise.allSettled(imagePromises);
            imageResults.forEach((result, index) => {
                const imageArea = document.getElementById(`card-image-area-${index}`);
                if (result.status === 'fulfilled' && result.value) {
                    imageArea.innerHTML = `<img src="${result.value}" alt="${drawnCards[index].name}" class="card-img">`;
                } else {
                    imageArea.innerHTML = `<div class="text-center text-red-400 p-4 font-semibold">Image generation failed</div>`;
                }
            });

            // 7. Finalize UI
            shuffleBtn.disabled = false;
            shuffleBtn.textContent = 'Draw 3 Cards';
        }

        async function generateSummary(promptContent) {
            const systemPrompt = "You are a concise, insightful oracle who interprets Sci-Fi/Cosmic Tarot cards. Synthesize the meanings of the three provided cards into a single, cohesive, 2-3 sentence paragraph that provides guidance based on the positions: Situation, Challenge/Action, and Outcome/Resolution. Do not use lists or bullet points. Start the summary with 'The Oracle reveals...'";
            const payload = {
                contents: [{ parts: [{ text: promptContent }] }],
                systemInstruction: { parts: [{ text: systemPrompt }] },
            };
            const result = await fetchTextWithExponentialBackoff(payload);
            return result.candidates?.[0]?.content?.parts?.[0]?.text || "The cosmos is currently too turbulent for a clear message. Please try again.";
        }

        // Attach event listeners
        document.getElementById('shuffleButton').addEventListener('click', drawCards);
        document.getElementById('speakButton').addEventListener('click', speakSummary);

        // Initial draw on load
        window.onload = drawCards;

    </script>
