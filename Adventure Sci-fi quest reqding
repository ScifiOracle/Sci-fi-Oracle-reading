<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sci-fi Oracle</title>
    <!-- Load Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Custom font for a clean, modern look */
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap');
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0d1117; /* Dark space background */
            color: #e5e7eb;
        }
        /* Custom card styling for visual appeal */
        .card-container {
            transition: transform 0.5s ease-in-out;
            perspective: 1000px;
        }
        .card {
            box-shadow: 0 10px 30px rgba(74, 20, 140, 0.5); /* Purple shadow */
            transition: all 0.5s ease-in-out;
            transform-style: preserve-3d;
            height: 400px; /* Fixed height for consistency */
        }
        .card:hover {
            box-shadow: 0 15px 45px rgba(167, 139, 250, 0.7); /* Lighter shadow on hover */
            transform: translateY(-5px);
        }
        .card-img {
            object-fit: cover;
            width: 100%;
            height: 100%; /* Image fills its container */
        }
        /* Style for the main button */
        #shuffleButton {
            background-image: linear-gradient(to right, #6d28d9, #8b5cf6);
            transition: transform 0.1s ease-out, box-shadow 0.1s ease-out;
        }
        #shuffleButton:hover {
            box-shadow: 0 4px 15px rgba(139, 92, 246, 0.6);
            transform: translateY(-1px);
        }
        /* Style for the TTS button */
        #speakButton {
            background-color: #10b981; /* Emerald green */
            transition: background-color 0.1s;
        }
        #speakButton:hover {
            background-color: #059669; 
        }

        /* Loading spinner animation */
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
        .loading-spinner {
            border: 4px solid rgba(255, 255, 255, 0.1);
            border-left-color: #8b5cf6;
            border-radius: 50%;
            width: 20px;
            height: 20px;
            animation: spin 1s linear infinite;
            margin-right: 8px;
        }
        .loading-spinner-small {
            border: 3px solid rgba(255, 255, 255, 0.1);
            border-left-color: #fff;
            border-radius: 50%;
            width: 16px;
            height: 16px;
            animation: spin 1s linear infinite;
            margin-right: 4px;
            display: inline-block;
        }
        .image-loader {
            border: 5px solid rgba(255, 255, 255, 0.2);
            border-left-color: #a78bfa; /* Lighter purple */
            border-radius: 50%;
            width: 50px;
            height: 50px;
            animation: spin 1.2s linear infinite;
        }
    </style>
</head>
<body class="min-h-screen p-4 md:p-8">

    <!-- App Header -->
    <header class="text-center mb-10">
